{
  "name": "@sikyeoyong/api",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && rm -rf dist/db/migrations && cp -R src/db/migrations dist/db/migrations",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/db/migrate.js",
    "db:seed": "node dist/db/seed.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.10.0",
    "@maroo-chain/viem": "0.5.0",
    "@nc-waas/sdk": "https://auth.pouchi.io/downloads/npm/nc-waas-sdk-0.1.0-beta.8.tgz",
    "@nestjs/common": "12.5.1",
    "@nestjs/core": "12.5.1",
    "@nestjs/platform-express": "12.5.1",
    "@sikyeoyong/shared": "workspace:*",
    "better-sqlite3": "13.2.0",
    "drizzle-orm": "0.45.4",
    "openai": "7.52.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "viem": "2.57.20",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.13",
    "@nestjs/testing": "12.5.1",
    "@swc/core": "1.16.22",
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "supertest": "7.3.2",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0"
  }
}
