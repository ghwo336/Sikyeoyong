{
  "name": "sikyeoyong",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@sikyeoyong/api --filter=@sikyeoyong/web",
    "dev:api": "turbo run dev --filter=@sikyeoyong/api",
    "dev:web": "turbo run dev --filter=@sikyeoyong/web",
    "dev:certs": "sh scripts/dev-certs.sh",
    "dev:web:https": "pnpm --filter @sikyeoyong/web dev:https",
    "ui:harness": "pnpm --filter @sikyeoyong/ui storybook",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint && node scripts/eslint-boundaries.test.mjs && prettier --check .",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "check:dash": "python3 -I scripts/check-dash.py",
    "check:wiki": "python3 -I scripts/check-wiki.py docs/wiki",
    "wiki:gc": "python3 -I scripts/wiki-gc.py",
    "verify": "python3 -I scripts/verify.py",
    "verify:test": "python3 -I scripts/verify_test.py",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @sikyeoyong/api build && pnpm --filter @sikyeoyong/api db:migrate",
    "db:seed": "pnpm --filter @sikyeoyong/api build && pnpm --filter @sikyeoyong/api db:seed",
    "merchants:balances": "pnpm --filter @sikyeoyong/api build && node apps/api/dist/db/merchant-keys/cli.js balances",
    "merchants:sweep": "pnpm --filter @sikyeoyong/api build && node apps/api/dist/db/merchant-keys/cli.js sweep",
    "agent-keys:rotate": "pnpm --filter @sikyeoyong/api build && node --env-file-if-exists=.env apps/api/dist/modules/payment/rotate-agent-keys.js",
    "topups:reconcile": "pnpm --filter @sikyeoyong/api build && node --env-file-if-exists=.env apps/api/dist/db/reconcile-topups.cli.js",
    "e2e:path-b": "pnpm --filter @sikyeoyong/api build && node --env-file-if-exists=.env apps/api/dist/modules/payment/e2e-path-b.js",
    "contracts:build": "forge build --root contracts",
    "contracts:test": "forge test --root contracts",
    "contracts:deploy:testnet": "node --env-file-if-exists=.env infra/scripts/deploy-orders.ts",
    "demo:rehearse": "node infra/scripts/demo-rehearse.ts",
    "policy:apply": "node --env-file-if-exists=.env infra/scripts/apply-policy.ts",
    "merchants:register": "node --env-file-if-exists=.env infra/scripts/register-merchants.ts",
    "merchants:sync-onchain": "pnpm --filter @sikyeoyong/api build && node apps/api/dist/db/merchant-onchain-sync.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
