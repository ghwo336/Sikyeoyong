{
  "name": "sikyeoyong",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint && node scripts/eslint-boundaries.test.mjs && prettier --check .",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "check:dash": "python3 -I scripts/check-dash.py",
    "check:wiki": "python3 -I scripts/check-wiki.py docs/wiki",
    "wiki:gc": "python3 -I scripts/wiki-gc.py",
    "verify": "python3 -I scripts/verify.py",
    "verify:test": "python3 -I scripts/verify_test.py",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
