# 시켜용 환경 변수 예시 (tech-spec 8.3). 비밀은 빈 값으로만 둔다 (CLAUDE.md 5).
# cp .env.example .env 후 값을 채운다. .env는 커밋하지 않는다.

# 서버
NODE_ENV=development
PORT=8787
PUBLIC_BASE_URL=http://localhost:3000
SESSION_SECRET=                       # 32바이트 이상 무작위
DATABASE_URL=file:./data/sikyeoyong.db  # 상대 경로는 실행 위치 기준 (pnpm으로 돌리면 apps/api/data/)
DEMO_MODE=false
DEMO_BYPASS_SERVER_LIMIT=false
# 개발 때만: OAuth 없이 POST /api/auth/dev-login으로 로그인 (production은 켜면 서버가 뜨지 않는다)
DEV_LOGIN=false
# 레벨 올리기 재인증: none은 테스트넷 데모의 버튼만(production은 부팅 거절), pouch는 파우치 지갑 서명(Q-30 전까지 거절) (D-28)
REAUTH_MODE=none

# 웹 (개발 때만: next dev가 /api를 이 주소로 넘긴다. 비우면 http://localhost:<위 PORT>. 운영은 Caddy가 넘긴다)
API_DEV_ORIGIN=
# 화면이 쓰는 API: 비우거나 mock이면 서버 없이 도는 흉내, http면 /api의 실제 서버 (로그인 라우트가 생긴 뒤에 쓸 수 있다)
NEXT_PUBLIC_API_MODE=
# 개발 때만: http 모드의 로그인 버튼이 API의 개발용 로그인(DEV_LOGIN=true)으로 이 키의 사용자로 들어간다
NEXT_PUBLIC_DEV_LOGIN_KEY=

# 로그인 (D-29: 파우치 로그인 하나. 값은 `pouchi keys create`가 만든 .env.pouchi에서 옮긴다)
POUCHI_API_URL=                       # 비우면 파우치 로그인 꺼짐 (예: https://api.pouchi.io)
POUCHI_TENANT_ID=
POUCHI_APP_KEY=                       # 비밀. 서버에만, NEXT_PUBLIC_ 금지
POUCHI_APP_ID=                        # pouchi apps origins add --app-id 값 (예: sikyeoyong)
POUCHI_VAULT_URL=                     # 비우면 https://auth.pouchi.io
POUCHI_BRIDGE_ISSUER=                 # 비우면 https://auth.pouchi.io
POUCHI_ENVIRONMENT=sandbox            # sandbox | production (앱 키 환경과 같아야 한다)
# 예전 계획(D-29 전): 카카오, 구글 OAuth
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_SECRET=
APPLE_SERVICE_ID=                     # 2단계

# AI
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic                # anthropic | openai (D-30). openai면 OPENAI_API_KEY와 OpenAI 모델 이름의 LLM_MODEL
OPENAI_API_KEY=                       # 비밀. 서버에만 (D-30)
LLM_MODEL=claude-opus-5-5             # 설정값, 코드에 하드코딩 금지 (D-22)
LLM_EFFORT=low                        # low | medium | high | xhigh | max (D-22, 데모 기본 low D-26)
LLM_MODE=live                         # live: Claude API / replay: 정해 둔 용이 턴 재생, API 호출 없음 (D-26)
LLM_DAILY_TOKEN_CAP=                  # 비우면 1000000. live 토큰(캐시 포함) 하루(KST) 상한, 닿으면 그날은 용이가 피곤하다는 한 줄만. 0이면 상한 없음 (D-26)
WEATHER_PROVIDER=static               # static | openmeteo (openmeteo는 키 없이 무료, 10분 캐시, 실패하면 날씨를 모르는 것으로 둔다)
WEATHER_STATIC=                       # static일 때 용이가 말할 날씨 한 단어. 비우면 맑음. 데모 장면에서 비로 정할 때 쓴다
WEATHER_LAT=                          # openmeteo 위치. 비우면 서울 강남 37.4979
WEATHER_LON=                          # 비우면 127.0276
# 로컬 개발과 체험판은 mock (kakao는 Q-19 전까지 인증이 거절되어 아무도 부화할 수 없다)
VERIFY_MODE=kakao                     # kakao | mock (D-16, 가입 본인 인증 방식)

# 체인
MAROO_RPC_URL=https://rpc-testnet.maroo.io
CHAIN_ID=450815                       # 부팅 시 eth_chainId와 대조, 변경 예정
OKRW_DENOM=atokrw
ORDERS_CONTRACT=                      # 프로필별 프록시 주소
ORDERS_DEPLOY_BLOCK=
POLICY_PROFILE=default                # default | demo
KYB_SCHEMA_UID=
OPERATOR_KEY=                         # 운영자: 가게 활성화, attestation 발급, 정책 admin(1단계)
CONFIRMATIONS=1

# 결제 경로
PAYMENT_PATH=mock                     # A | B | C | mock(개발·테스트 전용, production 금지). 스파이크 후 A, B, C 확정
OWNER_MODE=custodial                  # custodial(운영자가 소유자, 테스트넷) | pouch(사용자 파우치 지갑, SDK 출시 후). D-24
WAAS_AUTH_TOKEN=                      # 경로 A, C
AGENT_KEY_ENCRYPTION_KEY=             # 경로 B, 32바이트 base64
AGENT_FLOAT_MULTIPLIER=2              # 모드 P: 에이전트 지갑 유지액 = 건당 한도 × 이 값
AGENT_GAS_SHARE_OKRW=2000             # 경로 B: 에이전트 지갑에 가스용으로 더 두는 OKRW (D-25)
SUBMITTING_ALERT_MS=600000            # 결제 중(submitting) 주문이 이 시간 넘게 결론이 없으면 운영자 알림 (D-19)

# 2단계
NTS_SERVICE_KEY=
BIZNO_HMAC_KEY=
