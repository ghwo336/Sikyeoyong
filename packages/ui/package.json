{
  "name": "@sikyeoyong/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens/index.css"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "storybook": "storybook dev -p 6006 --no-open",
    "build": "storybook build -o storybook-static --quiet",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@sikyeoyong/shared": "workspace:*"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.7",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
